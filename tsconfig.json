{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["registry/data-table/components/ui/*"],
      "@ui/*": ["registry/data-table/components/ui/*"]
    }
  },
  "include": [
    "registry/data-table/components/**/*.ts",
    "registry/data-table/components/**/*.tsx",
    "vitest.config.ts",
    "vite.config.ts",
    "vitest.setup.tsx",
    "registry/data-table/components/data-table/global.d.ts"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
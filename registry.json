{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "inertia-datatables",
  "homepage": "https://github.com/tooinfinity/inertia-datatables",
  "items": [
    {
      "name": "data-table",
      "type": "registry:block",
      "title": "Data Table",
      "description": "Server-side DataTable with TanStack Table v9, Inertia 3, and shadcn/ui",
      "files": [
        {
          "path": "registry/data-table/components/data-table/types.ts",
          "type": "registry:component",
          "target": "components/data-table/types.ts"
        },
        {
          "path": "registry/data-table/components/data-table/data-table.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/data-table-toolbar.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table-toolbar.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/data-table-pagination.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table-pagination.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/data-table-column-header.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table-column-header.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/data-table-column-visibility.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table-column-visibility.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/data-table-empty.tsx",
          "type": "registry:component",
          "target": "components/data-table/data-table-empty.tsx"
        },
        {
          "path": "registry/data-table/components/data-table/use-data-table.ts",
          "type": "registry:component",
          "target": "components/data-table/use-data-table.ts"
        },
        {
          "path": "registry/data-table/components/ui/table.tsx",
          "type": "registry:component",
          "target": "components/ui/table.tsx"
        }
      ],
      "dependencies": [
        "@tanstack/react-table",
        "@inertiajs/react"
      ],
      "registryDependencies": [
        "button",
        "input",
        "dropdown-menu",
        "select",
        "checkbox",
        "table",
        "skeleton"
      ],
      "tailwind": {
        "config": {
          "theme": {
            "extend": {}
          }
        }
      }
    }
  ]
}

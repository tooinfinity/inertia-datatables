{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tooinfinity/inertia-datatables",
    "description": "Server-side DataTables for Laravel + Inertia 3 with React, TanStack Table v8, and shadcn/ui",
    "type": "library",
    "keywords": [
        "laravel",
        "tooinfinity",
        "inertia-datatables"
    ],
    "homepage": "https://github.com/tooinfinity/inertia-datatables",
    "license": "MIT",
    "authors": [
        {
            "name": "TouwfiQ Meghlaoui",
            "email": "touwfiqdev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "TooInfinity\\InertiaDataTables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TooInfinity\\InertiaDataTables\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "rector": [
          "vendor/bin/rector"
        ],
        "rector:check": [
        "vendor/bin/rector --dry-run"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@rector:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "TooInfinity\\InertiaDataTables\\InertiaDataTablesServiceProvider"
            ],
            "aliases": {
                "InertiaDataTables": "TooInfinity\\InertiaDataTables\\Facades\\InertiaDataTables"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
